# Copy to .env.local for local dev. Set the same values in Vercel > Project > Settings > Environment Variables.

# --- App -------------------------------------------------------------------
# Where the app is served from. Emails link to it (the client's report link), so it must be the live address.
NEXT_PUBLIC_APP_URL=https://your-domain-here
# Optional: a domain of its own for clients' review links, pointed at this same deployment (add it
# to the Vercel project's domains). Links are then https://review.dmgapps.com/<business-name>
# instead of <app>/review/<business-name>. Links and QR codes already out on the old address keep working.
NEXT_PUBLIC_REVIEW_URL=
# Shared team password for the dashboard login.
APP_PASSWORD=
# Shown in the email header and the screenshot watermark.
AGENCY_NAME=DMG

# --- MongoDB Atlas ---------------------------------------------------------
MONGODB_URI=
# Optional, defaults to dmg_tracker
MONGODB_DB=

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=
# Optional, defaults to gpt-4.1-mini. Must support image input. gpt-4.1-nano is ~3x cheaper, less careful.
OPENAI_MODEL=

# --- Google Places API (optional) ------------------------------------------
# Google's own rating and review count, which the signed-out screenshot often hides.
# Enable "Places API (New)" in Google Cloud and restrict the key to it. One Place Details call per
# report: 1,000 a month are free. Leave empty to rely on what the AI reads off the screenshot.
GOOGLE_PLACES_API_KEY=

# --- Cloudflare ------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
# Only used by wrangler when deploying the Worker from CI. Not read by the app.
CLOUDFLARE_API_TOKEN=
# Name of the Browser Run binding in workflows/wrangler.toml. Not read by the app.
CLOUDFLARE_BROWSER_BINDING=BROWSER
# URL of the deployed Worker, e.g. https://dmg-client-tracker-worker.<subdomain>.workers.dev
WORKER_URL=
# Long random string. Must equal the Worker's WORKER_SECRET secret.
WORKER_SECRET=

# --- Cloudflare R2 (S3 API token with Object Read & Write on the bucket) ---
# Shared bucket. Everything of ours sits under one folder (R2_PREFIX), in a folder per kind of file:
#   clients/<clientId>/      Google profile screenshots, written by the Worker
#   client-info/<clientId>/  the client's logo, written by this app (hence the write permission)
R2_BUCKET_NAME=dmg-common-bucket
# Optional, defaults to dmg-client-reports. Must match R2_PREFIX in workflows/wrangler.toml.
R2_PREFIX=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Umami -----------------------------------------------------------------
# Base URL of your Umami instance, with or without /api
UMAMI_API_URL=
# Self-hosted: the token returned by POST /api/auth/login. Umami Cloud: an API key.
UMAMI_API_KEY=
# Self-hosted alternative to UMAMI_API_KEY: the app logs in and fetches a token itself.
UMAMI_USERNAME=
UMAMI_PASSWORD=

# --- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "DMG Reports <reports@your-domain-here>"
EMAIL_FROM=
# Where a client's reply to any email lands. Optional, defaults to team@domoregrowth.com
EMAIL_REPLY_TO=
# While testing: send every email here instead of to the client. Outside the live site
# (VERCEL_ENV=production) nothing is sent at all unless this is set.
EMAIL_OVERRIDE_TO=
